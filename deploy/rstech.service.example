[Unit]
Description=RS TECH website
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/rstech/app
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATA_DIR=/opt/rstech/persist/data
EnvironmentFile=/etc/rstech/secrets.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/rstech/app/uploads /opt/rstech/persist/data

[Install]
WantedBy=multi-user.target
